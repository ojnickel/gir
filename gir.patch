-    chroot "Chroot only (enter $MNT)") || exit 0
+    chroot "Chroot only (enter $MNT)" \
+    remount "Live USB rebooted: mount existing install + chroot") || exit 0
 
 case "$mode" in
     full)   full_install ;;
     stage3) stage3_only ;;
     chroot) enter_chroot ;;
